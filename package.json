{
  "name": "hewtujmer",
  "version": "1.1.0",
  "description": "A Kurdish calendar, cultural events and Progressive Web App with optional private cloud notes and reminders.",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "dev": "nodemon backend/app.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-project.js",
    "build:mobile": "node scripts/build-mobile.js",
    "cap:add:android": "npm run build:mobile && node node_modules/@capacitor/cli/bin/capacitor add android",
    "cap:add:ios": "npm run build:mobile && node node_modules/@capacitor/cli/bin/capacitor add ios",
    "cap:sync": "npm run build:mobile && node node_modules/@capacitor/cli/bin/capacitor sync",
    "build:vercel": "node scripts/build-vercel.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MekoRasoulifard/Hewtujmer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MekoRasoulifard/Hewtujmer/issues"
  },
  "homepage": "https://github.com/MekoRasoulifard/Hewtujmer#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "cors": "^2.8.6",
    "deepl-node": "^1.28.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "i18next": "^26.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
